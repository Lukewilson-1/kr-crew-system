APP_NAME="CM & RM System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cms.krc.co.ke

LOG_CHANNEL=stack
LOG_LEVEL=error
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password


SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=kr_crew_system_session
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

# Maintenance mode sign-in (admin bypass while the site is offline).
MAINTENANCE_USERNAME=site@maintenance.com
MAINTENANCE_LOGIN=sitemaintenance
MAINTENANCE_PASSWORD=change-me-to-a-strong-password

# Secret token guarding the cron webhook (/running-rooms/cron/auto-checkout?token=...).
# MUST match the value baked into the cron-job.org job URL. Keep it URL-safe
# (hex/letters only — no + / = chars) and set the same value on the server.
# Generate one:  php -r "echo bin2hex(random_bytes(32));"
CRON_TOKEN=change-me

# How many trailing days of the current month remain editable for crew status
# corrections (today plus the previous n-1 days). Earlier days are locked.
CREW_PAST_DAY_EDIT_WINDOW_DAYS=2

# ----------------------------------------------------------------------------
# Mail / email notifications
# ----------------------------------------------------------------------------
# SMTP transport used to deliver notification emails. Set to "log" to write
# messages to storage/logs instead of sending (useful in dev/staging).
# See docs/SYSTEM_DOCUMENTATION.md §8.4 and config/notifications.php.
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-smtp-account@krc.co.ke
MAIL_PASSWORD=your-smtp-account-password
MAIL_FROM_ADDRESS=crew-system@krc.co.ke
MAIL_FROM_NAME="KR Crew System"

# Master switch for email delivery of system notifications. If FALSE the
# NotificationService still records in-app notifications but sends no email.
NOTIFICATIONS_EMAIL_ENABLED=true

# Recipients for operational / security alert emails (comma-separated).
# Used by NotificationService::emailAdmins() for alert-channel notifications.
ALERT_EMAIL_RECIPIENTS=ict-security@krc.co.ke,ict-helpdesk@krc.co.ke

# ----------------------------------------------------------------------------
# Break-glass / emergency access (see docs/SYSTEM_DOCUMENTATION.md §9.10)
# ----------------------------------------------------------------------------
# Master switch. Keep OFF in normal operation; enable only when SSO / normal
# login is unavailable and an authoritative admin must act.
BREAK_GLASS_ENABLED=false

# Shared credentials checked on the /break-glass-login page. Rotate quarterly
# with:  php artisan break-glass:rotate --update-env
BREAK_GLASS_USERNAME=kr-emergency
BREAK_GLASS_PASSWORD=change-me

# Local account the break-glass session logs in as (built-in superadmin).
BREAK_GLASS_LOGIN_AS=superadmin

# Maximum lifetime of a break-glass session in hours.
BREAK_GLASS_SESSION_HOURS=8

# Require the operator to justify the emergency access (audited).
BREAK_GLASS_REQUIRE_JUSTIFICATION=true
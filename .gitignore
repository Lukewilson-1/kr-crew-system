# Ignore environment variables and local settings
.env

# Ignore Composer vendor directory and runtime files
/vendor
/storage
/bootstrap/cache
/public/hot
/node_modules/

# Vite build artifacts (regenerated with npm run build)
/public/build

# Filament published assets (regenerated with php artisan filament:assets)
/public/css/filament
/public/js/filament
/public/fonts/filament

# User-uploaded matter photos (served from public/)
/public/matter-photos

# Test files
/tests

# Ignore OS files
.DS_Store
Thumbs.db


# Operator-only gap register (see working notes; never commit)
/docs/GAP-REGISTER.md

# =============================================================================
# KR Crew & Running-Room Management System — environment template
# =============================================================================
# Copy to .env and fill in. Never commit real secrets (see docs/sdlc/11-Credentials.md).
# Optional/advanced values are grouped at the bottom and can be left unset.

# ----------------------------------------------------------------------------
# Application core (Laravel 11 / PHP ^8.2 / Filament 4)
# ----------------------------------------------------------------------------
APP_NAME="CM & RM System"
APP_ENV=production            # local | test | production
APP_KEY=                      # generate:  php artisan key:generate
APP_DEBUG=false
APP_URL=https://cms.krc.co.ke

LOG_CHANNEL=stack
LOG_LEVEL=error               # emergency | alert | critical | error | warning | notice | info | debug
CACHE_DRIVER=file
CACHE_PREFIX=
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync          # sync | database | redis (redis requires the Redis block below)
QUEUE_FAILED_DRIVER=database
BROADCAST_DRIVER=log           # log | pusher (client-side Laravel Echo; optional)

# ----------------------------------------------------------------------------
# Sessions
# ----------------------------------------------------------------------------
SESSION_DRIVER=file            # file | database | redis
SESSION_LIFETIME=120
SESSION_COOKIE=kr_crew_system_session
SESSION_ENCRYPT=false
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true     # keep true behind TLS (production); false in dev
SESSION_DOMAIN=

# ----------------------------------------------------------------------------
# Database (MySQL 8.x primary DB — see docs/sdlc/12-Server-Environment-Requirements.md)
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# DB_SOCKET=                   # optional unix socket
# DB_FOREIGN_KEYS=true

# ----------------------------------------------------------------------------
# Super-admin bootstrap account (dev seed; configured via SeedSuperAdmin,
# also referenced by config/services.php). PRODUCTION: rotate immediately.
# ----------------------------------------------------------------------------
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin123   # DEV DEFAULT ONLY — change on first login

# ----------------------------------------------------------------------------
# Maintenance / hard-lockdown mode (see config/maintenance.php)
# ----------------------------------------------------------------------------
# The ONLY credential accepted while the site is offline. Two usernames map to
# the one shared passphrase. Rotate with: php artisan maintenance:rotate [--update-env]
MAINTENANCE_USERNAME=site@maintenance.com
MAINTENANCE_LOGIN=sitemaintenance
MAINTENANCE_PASSWORD=change-me-to-a-strong-password   # dev default was n0!!Pass10 — never ship that
MAINTENANCE_LOGIN_AS=superadmin
MAINTENANCE_TIMEZONE=Africa/Nairobi
# Hard lockdown on activation: signs out every session and revokes remember
# tokens. Keep true in production.
MAINTENANCE_LOCKDOWN=true

# ----------------------------------------------------------------------------
# Scheduled-task webhook token
# ----------------------------------------------------------------------------
# Guards /running-rooms/cron/auto-checkout?token=... . MUST be set (webhook 401
# otherwise) and match the value baked into the cron job URL. URL-safe only.
# Generate one:  php -r "echo bin2hex(random_bytes(32));"
CRON_TOKEN=change-me

# ----------------------------------------------------------------------------
# Crew daily-status editing window
# ----------------------------------------------------------------------------
# Trailing days of the current month editable (today + previous n-1 days).
CREW_PAST_DAY_EDIT_WINDOW_DAYS=2

# ----------------------------------------------------------------------------
# Mail (SMTP via KR relay is used for notification e-mails)
# ----------------------------------------------------------------------------
MAIL_MAILER=smtp               # smtp | log (log writes to storage/logs — handy in dev)
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-smtp-account@krc.co.ke
MAIL_PASSWORD=your-smtp-account-password
MAIL_FROM_ADDRESS=crew-system@krc.co.ke
MAIL_FROM_NAME="KR Crew System"
# MAIL_LOG_CHANNEL=stack       # used when MAIL_MAILER=log

# ----------------------------------------------------------------------------
# Notification service (in-app + email copies; see config/notifications.php)
# ----------------------------------------------------------------------------
# Master switch: persist in-app notifications and send email copies. If FALSE,
# in-app records are still stored but no email is sent.
NOTIFICATIONS_EMAIL_ENABLED=true
# Recipients for operational / security alert e-mails (comma-separated).
ALERT_EMAIL_RECIPIENTS=ict-security@krc.co.ke,ict-helpdesk@krc.co.ke
# Hook for pruning read in-app notifications (currently unused).
NOTIFICATIONS_RETENTION_DAYS=90

# ----------------------------------------------------------------------------
# Break-glass / emergency access (see config/breakglass.php)
# ----------------------------------------------------------------------------
# Keep OFF in normal operation; enable only when normal login is unavailable and
# an authoritative admin must act. Rotate quarterly with:
#   php artisan break-glass:rotate --update-env
BREAK_GLASS_ENABLED=false
BREAK_GLASS_USERNAME=kr-emergency
BREAK_GLASS_PASSWORD=change-me
BREAK_GLASS_LOGIN_AS=superadmin
BREAK_GLASS_SESSION_HOURS=8
BREAK_GLASS_REQUIRE_JUSTIFICATION=true

# =============================================================================
# OPTIONAL / ADVANCED (leave as shipped unless you enable the feature)
# =============================================================================

# --- Redis (cache/session/queue) ---------------------------------------------
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_QUEUE=default
# REDIS_PREFIX=kr_crew

# --- Pusher / Echo (client-side broadcasting; currently not server-consumed) ---
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# PUSHER_SCHEME=https
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_APP_USE_TLS=true

# --- AWS S3 (alternate storage driver for FILESYSTEM_DRIVER=s3) --------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Hashing (only if you deviate from Laravel defaults) ----------------------
# BCRYPT_ROUNDS=12
# HASH_DRIVER=bcrypt